{
  "name": "ponder",
  "version": "0.16.8",
  "description": "An open-source TypeScript framework for EVM data indexing",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ponder-sh/ponder",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/_test/**/*",
    "!**/*.test.ts",
    "!**/*.bench.ts",
    "!**/*.test-d.ts",
    "!**/*.tsbuildinfo",
    "CHANGELOG.md",
    "README.md",
    "tsconfig.json",
    "LICENSE"
  ],
  "bin": {
    "ponder": "./dist/esm/bin/ponder.js"
  },
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./virtual": {
      "types": "./src/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsx build.ts",
    "test": "vitest",
    "test:bun": "bun test",
    "test:typecheck": "vitest --typecheck.only",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "hono": "catalog:peer",
    "typescript": "catalog:peer",
    "viem": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/code-frame": "catalog:runtime",
    "@commander-js/extra-typings": "catalog:runtime",
    "@electric-sql/pglite": "catalog:db",
    "@escape.tech/graphql-armor-max-aliases": "catalog:runtime",
    "@escape.tech/graphql-armor-max-depth": "catalog:runtime",
    "@escape.tech/graphql-armor-max-tokens": "catalog:runtime",
    "@hono/node-server": "catalog:runtime",
    "@ponder/utils": "workspace:*",
    "abitype": "catalog:web3",
    "ansi-escapes": "catalog:runtime",
    "commander": "catalog:runtime",
    "conf": "catalog:runtime",
    "dataloader": "catalog:runtime",
    "detect-package-manager": "catalog:runtime",
    "dotenv": "catalog:runtime",
    "drizzle-orm": "catalog:db",
    "glob": "catalog:runtime",
    "graphql": "catalog:runtime",
    "graphql-yoga": "catalog:runtime",
    "http-terminator": "catalog:runtime",
    "kysely": "catalog:db",
    "pg": "catalog:db",
    "pg-connection-string": "catalog:db",
    "pg-copy-streams": "catalog:db",
    "pg-query-emscripten": "catalog:db",
    "picocolors": "catalog:runtime",
    "pino": "catalog:runtime",
    "prom-client": "catalog:runtime",
    "semver": "catalog:runtime",
    "stacktrace-parser": "catalog:runtime",
    "superjson": "catalog:runtime",
    "terminal-size": "catalog:runtime",
    "vite": "catalog:tooling",
    "vite-node": "catalog:tooling",
    "vite-tsconfig-paths": "catalog:tooling",
    "ws": "catalog:runtime"
  },
  "devDependencies": {
    "@pgsql/types": "catalog:db",
    "@ponder/client": "workspace:*",
    "@types/babel__code-frame": "catalog:runtime",
    "@types/glob": "catalog:runtime",
    "@types/node": "catalog:",
    "@types/pg": "catalog:db",
    "@types/pg-copy-streams": "catalog:db",
    "@types/semver": "catalog:runtime",
    "@types/ws": "catalog:runtime",
    "@viem/anvil": "catalog:web3",
    "@wagmi/cli": "catalog:web3",
    "chokidar": "catalog:tooling",
    "execa": "catalog:tooling",
    "mitata": "catalog:tooling",
    "rimraf": "catalog:tooling",
    "tsx": "catalog:tooling",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=18.14"
  }
}
