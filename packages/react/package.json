{
  "name": "@ponder/react",
  "version": "0.18.6",
  "description": "React hook library for Ponder SQL over HTTP queries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ponder-sh/ponder",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "typecheck": "bun check"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.bench.ts",
    "!src/_test/**/*",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "superjson": "2.2.2"
  },
  "peerDependencies": {
    "@ponder/client": ">=0.18.6",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18",
    "typescript": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ponder/client": "0.18.6",
    "@tanstack/react-query": "5.12.2",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.1",
    "@types/react": "18.2.37",
    "react": "18.2.0"
  }
}
