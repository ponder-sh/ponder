{
  "name": "@ponder/react",
  "version": "0.16.8",
  "description": "React hook library for Ponder SQL over HTTP queries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ponder-sh/ponder",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsx build.ts",
    "test": "vitest",
    "test:typecheck": "vitest --typecheck.only",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/**",
    "!dist/**/*.tsbuildinfo",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/_test/**/*",
    "README.md",
    "tsconfig.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "dependencies": {
    "superjson": "catalog:runtime"
  },
  "peerDependencies": {
    "@ponder/client": "catalog:peer",
    "@tanstack/react-query": "catalog:peer",
    "react": "catalog:peer",
    "typescript": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ponder/client": "workspace:*",
    "@tanstack/react-query": "catalog:react",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "chokidar": "catalog:tooling",
    "execa": "catalog:tooling",
    "picocolors": "catalog:runtime",
    "react": "catalog:react",
    "rimraf": "catalog:tooling",
    "tsx": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
