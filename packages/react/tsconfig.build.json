{
  "extends": "./tsconfig.json",
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "src/**/*.bench.ts",
    "src/_test"
  ],
  "compilerOptions": {
    // Source files don't use Bun APIs; only the test files need `bun:test` types.
    "types": ["node"],
    "incremental": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
