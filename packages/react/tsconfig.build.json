{
  "extends": "./tsconfig.json",
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-d.ts",
    "src/**/*.bench.ts",
    "src/_test"
  ],
  "compilerOptions": {
    // Source files don't use Bun APIs; only the test files need `bun:test` types.
    "types": ["node"],
    "incremental": false,
    // Resolve `@ponder/client` from its built package, not the source mapping in `tsconfig.json`.
    "paths": {},
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
