{
  "name": "@ponder/client",
  "version": "0.16.8",
  "description": "Client library for Ponder SQL over HTTP queries",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ponder-sh/ponder",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/_test/**/*",
    "README.md",
    "tsconfig.json",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:typecheck": "vitest --typecheck.only",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "drizzle-orm": "catalog:db",
    "eventsource": "catalog:runtime",
    "superjson": "catalog:runtime"
  },
  "devDependencies": {
    "tsup": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
