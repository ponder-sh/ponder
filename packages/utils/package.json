  "peerDependencies": {
    "typescript": ">=5.4.0",
    "viem": ">=2.35"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "22.20.1",
    "abitype": "1.2.3",
    "dotenv": "16.4.5"
  }
