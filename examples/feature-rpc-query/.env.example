# Set this to a Monad RPC endpoint with eth_query* support. Standard public
# Monad RPC endpoints do not implement the experimental query methods.
PONDER_RPC_URL_143=
# Set this to a standard Monad RPC endpoint for all other requests.
PONDER_RPC_URL_143_STANDARD=

# (Optional) Postgres database URL. If not provided, PGlite will be used.
DATABASE_URL=
